<?xml version="1.0" encoding="utf-8"?>
<!--
    Data extraction rules (Android 12+): cloud backup and device-to-device
    transfer. Mirrors backup_rules.xml — RoutineFlow stores only local
    routine data (routines, modes, run history, preferences) with no
    account, no credentials and nothing sensitive, so everything is included.
-->
<data-extraction-rules xmlns:android="http://schemas.android.com/apk/res/android">
    <cloud-backup>
        <include domain="database" path="." />
        <include domain="sharedpref" path="." />
        <include domain="file" path="." />
        <include domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <include domain="sharedpref" path="." />
        <include domain="file" path="." />
        <include domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
